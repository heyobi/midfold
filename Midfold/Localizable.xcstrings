{
  "sourceLanguage": "en",
  "strings": {
    "%lld feathers left": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tüy kaldı"
          }
        }
      }
    },
    "%lld of 3 stars": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 yıldızdan %lld"
          }
        }
      }
    },
    "%lld%% of the way": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yolun %%%lld kadarı"
          }
        }
      }
    },
    "A new course every day, the same for everyone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün yeni bir parkur, herkes için aynı."
          }
        }
      }
    },
    "A paper bird, one flap at a time": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kâğıt bir kuş, her seferinde bir kanat çırpışı"
          }
        }
      }
    },
    "All worlds are unlocked.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm dünyaların kilidi açıldı."
          }
        }
      }
    },
    "All worlds unlocked": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm dünyaların kilidi açık"
          }
        }
      }
    },
    "Best %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekor %lld"
          }
        }
      }
    },
    "Best played sideways": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yan tutarak oynayın"
          }
        }
      }
    },
    "Continue %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam et %@"
          }
        }
      }
    },
    "Daily": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük"
          }
        }
      }
    },
    "Daily flight": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günün uçuşu"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti"
          }
        }
      }
    },
    "Endless": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonsuz"
          }
        }
      }
    },
    "Endless mode with a leaderboard": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıralamalı sonsuz mod"
          }
        }
      }
    },
    "Flight": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçuş"
          }
        }
      }
    },
    "Got it": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anladım"
          }
        }
      }
    },
    "Gusty Cliffs": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rüzgârlı Yamaçlar"
          }
        }
      }
    },
    "Gusty Cliffs: drafts and sliding gates": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rüzgârlı Yamaçlar: rüzgârlar ve kayan kapılar"
          }
        }
      }
    },
    "Haptics": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titreşim"
          }
        }
      }
    },
    "Higher sensitivity makes small pumps flap harder. Without a hinge, tap to flap.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek hassasiyette küçük pompalar da güçlü kanat çırpar. Menteşe yoksa kanat çırpmak için dokunun."
          }
        }
      }
    },
    "Hinge angle %lld degrees": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menteşe açısı %lld derece"
          }
        }
      }
    },
    "Hold the phone sideways, half open. Close it a little and open it again: every pump is a wing flap.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu yan tutun, yarıya kadar açık. Biraz kapatıp yeniden açın: her pompa bir kanat çırpışı."
          }
        }
      }
    },
    "How far can Kip go? It only gets harder.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kip ne kadar uzağa gidebilir? Gittikçe zorlaşır."
          }
        }
      }
    },
    "Ink Caves": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mürekkep Mağaraları"
          }
        }
      }
    },
    "Ink Caves: tunnels that need gentle pumps": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mürekkep Mağaraları: nazik pompa isteyen tüneller"
          }
        }
      }
    },
    "Leaderboards": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıralamalar"
          }
        }
      }
    },
    "Leaderboards and achievements": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıralamalar ve başarımlar"
          }
        }
      }
    },
    "Level %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölüm %@"
          }
        }
      }
    },
    "Level complete!": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölüm tamam!"
          }
        }
      }
    },
    "Locked": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitli"
          }
        }
      }
    },
    "Made for iPhone Duo, where you fly by pumping the hinge. Here, tap to flap.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Duo için tasarlandı; orada menteşeyi pompalayarak uçarsınız. Burada kanat çırpmak için dokunun."
          }
        }
      }
    },
    "Made for iPhone Duo: hold it sideways, half open, and pump the hinge.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Duo için tasarlandı: yan tutun, yarıya kadar açın ve menteşeyi pompalayın."
          }
        }
      }
    },
    "Menu": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü"
          }
        }
      }
    },
    "Midfold": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Midfold"
          }
        }
      }
    },
    "Narrow tunnels that need gentle pumps.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazik pompalar isteyen dar tüneller."
          }
        }
      }
    },
    "New best!": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni rekor!"
          }
        }
      }
    },
    "Next level": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki bölüm"
          }
        }
      }
    },
    "No accounts, no ads, no tracking. Your progress stays on this device; Game Center is optional.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap yok, reklam yok, izleme yok. İlerlemeniz bu cihazda kalır; Game Center isteğe bağlıdır."
          }
        }
      }
    },
    "No earlier purchase was found for this Apple Account.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple Hesabında önceki bir satın alma bulunamadı."
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi değil"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamam"
          }
        }
      }
    },
    "On iPhone Duo you pump the hinge instead.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Duo'da bunun yerine menteşeyi pompalarsınız."
          }
        }
      }
    },
    "One purchase, no subscription, no ads": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik satın alma, abonelik yok, reklam yok"
          }
        }
      }
    },
    "Or pump the hinge to fly again": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya da yeniden uçmak için menteşeyi pompalayın"
          }
        }
      }
    },
    "Out of feathers": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüyler bitti"
          }
        }
      }
    },
    "Paper Meadow": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kâğıt Çayır"
          }
        }
      }
    },
    "Pause": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklat"
          }
        }
      }
    },
    "Paused": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatıldı"
          }
        }
      }
    },
    "Play": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyna"
          }
        }
      }
    },
    "Progress %lld percent": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleme yüzde %lld"
          }
        }
      }
    },
    "Pump sensitivity": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pompa hassasiyeti"
          }
        }
      }
    },
    "Pump the hinge or tap to flap": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanat çırpmak için menteşeyi pompalayın ya da dokunun"
          }
        }
      }
    },
    "Pump the hinge to fly": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçmak için menteşeyi pompalayın"
          }
        }
      }
    },
    "Pump to flap": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pompala, kanat çırp"
          }
        }
      }
    },
    "Quick, deep pumps flap hard. Small pumps make small hops, perfect for tunnels.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı ve derin pompalar güçlü çırpar. Küçük pompalar küçük sıçramalar yapar; tüneller için ideal."
          }
        }
      }
    },
    "Restart": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden başla"
          }
        }
      }
    },
    "Restore purchases": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alımları geri yükle"
          }
        }
      }
    },
    "Resume": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam"
          }
        }
      }
    },
    "Retry": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar"
          }
        }
      }
    },
    "Rolling hills and paper gates. Learn the rhythm.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalgalı tepeler ve kâğıt kapılar. Ritmi öğrenin."
          }
        }
      }
    },
    "Run over": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçuş bitti"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar"
          }
        }
      }
    },
    "Sound": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses"
          }
        }
      }
    },
    "Source code and privacy": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak kodu ve gizlilik"
          }
        }
      }
    },
    "Tap anywhere to flap. Kip sinks between flaps, so find a rhythm.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanat çırpmak için herhangi bir yere dokunun. Kip çırpışlar arasında alçalır, ritmi yakalayın."
          }
        }
      }
    },
    "Tap to flap": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanat çırpmak için dokunun"
          }
        }
      }
    },
    "Tap to fly": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçmak için dokunun"
          }
        }
      }
    },
    "The purchase did not go through. Nothing was charged.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma tamamlanmadı. Ücret alınmadı."
          }
        }
      }
    },
    "The purchase is waiting for approval.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma onay bekliyor."
          }
        }
      }
    },
    "The store is not available right now. Try again later.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mağazaya şu anda ulaşılamıyor. Daha sonra yeniden deneyin."
          }
        }
      }
    },
    "Today's best %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün rekoru %lld"
          }
        }
      }
    },
    "Try it": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneyin"
          }
        }
      }
    },
    "Unlock": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilidi aç"
          }
        }
      }
    },
    "Unlock all worlds": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm dünyaların kilidini aç"
          }
        }
      }
    },
    "Unlock for %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ karşılığında aç"
          }
        }
      }
    },
    "Unlocked. Have fun!": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit açıldı. İyi eğlenceler!"
          }
        }
      }
    },
    "Up- and downdrafts and gates that slide.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarı ve aşağı esen rüzgârlar, kayan kapılar."
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm"
          }
        }
      }
